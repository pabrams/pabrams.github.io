---
import Header from '../../components/Header.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('blog', ({ data }) => import.meta.env.PROD ? !data.draft : true);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
};

const { post } = Astro.props;
const { Content } = await render(post);

const dateFmt = new Intl.DateTimeFormat('en-CA', { year: 'numeric', month: 'short', day: 'numeric' });
---

<!DOCTYPE html>
<html>
  <Header title={`${post.data.title} | Paul Abrams`} />
  <body>
    <div class="content">
      <Sidebar selectedItem="blog" />
      <nav class="main">
        <div class="container">
          <div class="back-nav-container">
            <a href="/blog" class="back-nav-button w-inline-block">
              <img src="/assets/back.svg" loading="lazy" alt="" class="back-nav-img" />
              <div>Back to blog</div>
            </a>
          </div>
          <article class="content-container blog-post">
            <h1>{post.data.title}</h1>
            <div class="blog-meta">
              <time datetime={post.data.pubDate.toISOString()}>{dateFmt.format(post.data.pubDate)}</time>
              {post.data.updatedDate && (
                <span> · updated {dateFmt.format(post.data.updatedDate)}</span>
              )}
            </div>
            {post.data.tags.length > 0 && (
              <div class="chips-container">
                {post.data.tags.map((tag: string) => <span class="single-chip small-chip">{tag}</span>)}
              </div>
            )}
            <div class="blog-body w-richtext">
              <Content />
            </div>
          </article>
        </div>
      </nav>
    </div>
    <style>
      .blog-post {
        max-width: 720px;
      }
      .blog-meta {
        color: #AA0000;
        font-size: 0.95rem;
        font-family: 'IBM Plex Mono', monospace;
        margin-bottom: 1rem;
      }
      .blog-body {
        margin-top: 2rem;
        font-family: 'IBM Plex Serif', Georgia, serif;
        font-size: 21px;
        line-height: 1.7;
        color: #008888;
      }
      .blog-body :global(p) {
        font-family: inherit;
        font-size: inherit;
        line-height: inherit;
        color: inherit;
        margin: 0 0 1.2em 0;
      }
      .blog-body :global(h2) {
        margin-top: 2.4rem;
        margin-bottom: 0.7rem;
        font-size: 32px;
        line-height: 1.3;
      }
      .blog-body :global(h3) {
        margin-top: 2rem;
        margin-bottom: 0.5rem;
        font-size: 25px;
        line-height: 1.3;
      }
      .blog-body :global(strong) {
        color: #00DDDD;
      }
      .blog-body :global(em) {
        color: inherit;
      }
      .blog-body :global(a) {
        color: #FF0000;
        text-decoration: underline;
        text-decoration-color: #AA0000;
        text-underline-offset: 3px;
      }
      .blog-body :global(a:hover) {
        text-decoration-color: #FF0000;
      }
      .blog-body :global(blockquote) {
        border-left: 3px solid #AA0000;
        margin: 1.5em 0;
        padding: 0.2em 1em;
        color: #008888;
        font-style: italic;
      }
      .blog-body :global(ul),
      .blog-body :global(ol) {
        padding-left: 1.5em;
        margin: 0 0 1.2em 0;
      }
      .blog-body :global(li) {
        margin-bottom: 0.4em;
      }
      .blog-body :global(pre) {
        background: #1a0000;
        border: 1px solid #3a0000;
        padding: 1rem;
        border-radius: 6px;
        overflow-x: auto;
        font-size: 14px;
      }
      .blog-body :global(code) {
        background: #1a0000;
        color: #FF0000;
        padding: 0.1em 0.35em;
        border-radius: 3px;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.9em;
      }
      .blog-body :global(pre code) {
        background: transparent;
        padding: 0;
        color: #00DDDD;
      }
      .blog-body :global(table) {
        width: 100%;
        border-collapse: collapse;
        margin: 1.5em 0;
        font-size: 0.95em;
        background: #1a0000;
        border: 1px solid #AA0000;
      }
      .blog-body :global(thead) {
        background: #3a0000;
      }
      .blog-body :global(th) {
        color: #FF0000;
        text-align: left;
        padding: 10px 14px;
        border-bottom: 2px solid #AA0000;
        font-family: 'IBM Plex Sans', sans-serif;
        font-weight: 600;
      }
      .blog-body :global(td) {
        padding: 10px 14px;
        border-top: 1px solid #3a0000;
        color: #008888;
        vertical-align: top;
      }
      .blog-body :global(tbody tr:hover) {
        background: #280000;
      }
      .blog-body :global(td code),
      .blog-body :global(th code) {
        font-size: 0.9em;
      }
      .blog-body :global(hr) {
        border: none;
        border-top: 1px solid #AA0000;
        margin: 2em 0;
      }
      .blog-body :global(img) {
        max-width: 100%;
        height: auto;
      }
    </style>
  </body>
</html>
